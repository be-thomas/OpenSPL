{
  "default_index": "logs-*",
  "time_field": "@timestamp",
  "text_field": "message",
  "fields": {
    "src": "source.address",
    "dest": "destination.address"
  },
  "indexes": {
    "web": "logs-web-*"
  },
  "datamodels": {
    "Web": "logs-web-*",
    "Endpoint.Processes": "logs-endpoint-processes-*"
  },
  "prometheus": {
    "metric": "splunk_events_total",
    "index_label": "job",
    "function": "increase",
    "labels": {
      "host.name": "instance"
    }
  },
  "timechart": {
    "default_span": "5m"
  },
  "bin": {
    "default_span": "5m"
  }
}
