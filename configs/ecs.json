{
  "default_index": "logs-*",
  "time_field": "@timestamp",
  "text_field": "message",
  "fields": {
    "host": "host.name",
    "source": "log.file.path",
    "sourcetype": "event.dataset"
  },
  "indexes": {},
  "prometheus": {
    "metric": "splunk_events_total",
    "index_label": "job",
    "function": "increase",
    "labels": {
      "host.name": "host",
      "event.dataset": "sourcetype",
      "log.file.path": "file"
    }
  },
  "timechart": {
    "default_span": "5m"
  },
  "bin": {
    "default_span": "5m"
  }
}
